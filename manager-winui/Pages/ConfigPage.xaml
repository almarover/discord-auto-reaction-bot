<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DiscordReactionManager_WinUI.Pages.ConfigPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded">

    <Grid Padding="26,20,26,24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock FontSize="28" FontWeight="SemiBold" Text="配置" />
                <TextBlock Margin="0,5,0,0" Foreground="{StaticResource SecondaryTextBrush}" Text="按服务器管理目标用户、专属 Reaction 与随机概率" />
            </StackPanel>
            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Click="SaveTarget_Click" Content="保存用户配置" Background="#236B45" />
        </Grid>

        <Border Grid.Row="1" Padding="16" Background="{StaticResource CardBrush}" CornerRadius="6">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="420" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="服务器" />
                <ComboBox x:Name="ServerCombo" Grid.Column="1" SelectionChanged="ServerCombo_SelectionChanged" />
                <TextBlock x:Name="ServerSummaryText" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{StaticResource SecondaryTextBrush}" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Padding="16" Background="{StaticResource CardBrush}" CornerRadius="6">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock VerticalAlignment="Center" FontSize="17" FontWeight="SemiBold" Text="目标用户" />
                        <Button HorizontalAlignment="Right" Click="NewTarget_Click" Content="＋ 添加" />
                    </Grid>
                    <ListView x:Name="TargetList" Grid.Row="1" SelectionChanged="TargetList_SelectionChanged" SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="5" ColumnSpacing="8">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Label}" />
                                    <TextBlock Grid.Row="1" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding UserId}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Grid Grid.Row="2">
                        <TextBlock x:Name="TargetCountText" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" Text="共 0 个用户" />
                        <Button HorizontalAlignment="Right" Click="DeleteTarget_Click" Content="删除选中" Foreground="{StaticResource DangerBrush}" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Padding="18" Background="{StaticResource CardBrush}" CornerRadius="6">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="用户详细配置" />
                        <TextBlock x:Name="EditingStateText" HorizontalAlignment="Right" Foreground="{StaticResource AccentGreenBrush}" Text="新用户" />
                    </Grid>

                    <Grid Grid.Row="1" ColumnSpacing="12" RowSpacing="9">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock FontWeight="SemiBold" Text="用户 ID" />
                        <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="备注" />
                        <TextBox x:Name="UserIdText" Grid.Row="1" PlaceholderText="Discord 用户数字 ID" />
                        <TextBox x:Name="UserLabelText" Grid.Row="1" Grid.Column="1" PlaceholderText="用于辨认的备注" />
                        <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,4,0,0" ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="专属 Reaction 生效频道" />
                            <TextBlock x:Name="TargetChannelSummaryText" Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" Text="全部可访问文字频道" TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="2" Click="ChooseTargetChannels_Click" Content="选择频道" />
                        </Grid>
                    </Grid>

                    <TabView Grid.Row="2" IsAddTabButtonVisible="False">
                        <TabViewItem Header="专属 Reaction" IsClosable="False">
                            <Grid Padding="0,12,0,0" RowSpacing="10">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <TextBlock Foreground="{StaticResource SecondaryTextBrush}" Text="每行一个；这里的 Reaction 只应用于当前用户，右侧会逐项预览。" />
                                <Grid Grid.Row="1" ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.25*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="DedicatedReactionText" MinHeight="300" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" TextChanged="ReactionText_TextChanged" />
                                    <Border Grid.Column="1" Padding="10" Background="{StaticResource CardHoverBrush}" CornerRadius="5">
                                        <Grid RowSpacing="8">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                            <TextBlock FontWeight="SemiBold" Text="专属表情预览" />
                                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                                <StackPanel x:Name="DedicatedPreviewRows" Spacing="7" />
                                            </ScrollViewer>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </TabViewItem>
                        <TabViewItem Header="随机抽取与概率" IsClosable="False">
                            <Grid Padding="0,12,0,0" RowSpacing="10">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="96" /></Grid.ColumnDefinitions>
                                    <ToggleSwitch x:Name="NoReactionSwitch" Header="启用不进行Reaction" Toggled="NoReactionSwitch_Toggled" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="不进行概率" />
                                    <NumberBox x:Name="NoReactionProbabilityBox" Grid.Column="2" Width="88" Height="36" HorizontalAlignment="Right" VerticalAlignment="Center" HorizontalContentAlignment="Center" Minimum="0" Maximum="100" SmallChange="1" SpinButtonPlacementMode="Compact" Value="0" />
                                </Grid>
                                <Grid Grid.Row="1">
                                    <ToggleSwitch x:Name="RandomSwitch" Header="从专属 Reaction 中随机抽取 1 个" Toggled="RandomSwitch_Toggled" />
                                    <Button HorizontalAlignment="Right" Click="EqualWeights_Click" Content="一键均分" />
                                </Grid>
                                <TextBlock Grid.Row="2" Foreground="{StaticResource SecondaryTextBrush}" Text="两个开关都关闭时，默认添加该用户的全部专属 Reaction；只开启“不进行 Reaction”时，未跳过则添加全部；两个同时开启时，未跳过再按概率随机抽取 1 个。公共 Reaction 使用公共页面自己的设置。" TextWrapping="Wrap" />
                                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="ProbabilityRows" Spacing="7" />
                                </ScrollViewer>
                                <Grid Grid.Row="4">
                                    <TextBlock Foreground="{StaticResource SecondaryTextBrush}" Text="此处概率仅作用于专属 Reaction；公共 Reaction 使用公共页面中的独立设置。" />
                                    <TextBlock x:Name="ProbabilityTotalText" HorizontalAlignment="Right" FontSize="18" FontWeight="SemiBold" Text="总计 0%" />
                                </Grid>
                            </Grid>
                        </TabViewItem>
                    </TabView>

                    <StackPanel Grid.Row="3" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10">
                        <Button Click="ClearEditor_Click" Content="清空输入" />
                        <Button Click="SaveTarget_Click" Content="添加 / 更新用户" Background="#236B45" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <InfoBar x:Name="MessageBar" Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="20" IsOpen="False" IsClosable="True" />
    </Grid>
</Page>
