<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DiscordReactionManager_WinUI.Pages.LogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded" Unloaded="Page_Unloaded">

    <Grid Padding="26,20,26,24" RowSpacing="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid>
            <StackPanel>
                <TextBlock FontSize="28" FontWeight="SemiBold" Text="日志" />
                <TextBlock Margin="0,5,0,0" Foreground="{StaticResource SecondaryTextBrush}" Text="查看管理器和 Bot 的实时输出，不记录用户消息正文" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                <ComboBox x:Name="FilterCombo" Width="150" SelectionChanged="FilterCombo_SelectionChanged">
                    <ComboBoxItem Content="全部日志" IsSelected="True" Tag="all" />
                    <ComboBoxItem Content="仅错误" Tag="error" />
                    <ComboBoxItem Content="仅 Reaction" Tag="reaction" />
                </ComboBox>
                <ToggleSwitch x:Name="PauseSwitch" Header="暂停滚动" />
                <Button Click="Clear_Click" Content="清空显示" />
                <Button Click="OpenFolder_Click" Content="打开日志文件夹" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Padding="12" Background="#252B28" CornerRadius="5">
            <TextBlock x:Name="LogStatusText" Foreground="{StaticResource SecondaryTextBrush}" Text="日志会每秒刷新" />
        </Border>

        <Border Grid.Row="2" Padding="12" Background="#171715" CornerRadius="6">
            <TextBox x:Name="LogText" AcceptsReturn="True" FontFamily="Cascadia Mono, Consolas" FontSize="13" IsReadOnly="True" TextWrapping="NoWrap" VerticalContentAlignment="Top" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
        </Border>
    </Grid>
</Page>
