<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DiscordReactionManager_WinUI.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded" Unloaded="Page_Unloaded">

    <ScrollViewer>
        <StackPanel Padding="26,20,26,28" Spacing="18">
            <Grid>
                <StackPanel>
                    <TextBlock FontSize="28" FontWeight="SemiBold" Text="主页" />
                    <TextBlock Margin="0,5,0,0" Foreground="{StaticResource SecondaryTextBrush}" Text="控制 Bot、查看连接状态和服务器概览" />
                </StackPanel>
                <Border x:Name="HeaderStatusBorder" HorizontalAlignment="Right" VerticalAlignment="Top" MinWidth="122" Height="54" Padding="16,8" Background="#2F302E" CornerRadius="5">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                        <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{StaticResource AccentGreenBrush}" />
                        <TextBlock x:Name="HeaderStatusText" VerticalAlignment="Center" TextAlignment="Center" Foreground="{StaticResource AccentGreenBrush}" Text="正在检查" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.25*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Padding="20" Background="{StaticResource CardBrush}" CornerRadius="6">
                    <StackPanel Spacing="12">
                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="Bot Token" />
                        <TextBlock Foreground="{StaticResource SecondaryTextBrush}" Text="Token 仅保存在本机 .env 文件中。" />
                        <PasswordBox x:Name="TokenBox" PasswordRevealMode="Peek" PlaceholderText="输入 Discord Bot Token" />
                        <Button HorizontalAlignment="Left" Click="SaveToken_Click" Content="保存 Token" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Padding="20" Background="{StaticResource CardBrush}" CornerRadius="6">
                    <StackPanel Spacing="8">
                        <FontIcon HorizontalAlignment="Left" FontSize="28" Foreground="{StaticResource AccentGreenBrush}" Glyph="&#xE968;" />
                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="服务器状态" />
                        <TextBlock x:Name="ServerCountText" FontSize="30" FontWeight="SemiBold" Text="0" />
                        <TextBlock Foreground="{StaticResource SecondaryTextBrush}" Text="已连接服务器" />
                        <Button HorizontalAlignment="Left" Click="ViewServers_Click" Content="查看全部" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Padding="20" Background="{StaticResource CardBrush}" CornerRadius="6">
                    <StackPanel Spacing="8">
                        <FontIcon HorizontalAlignment="Left" FontSize="28" Foreground="{StaticResource AccentGreenBrush}" Glyph="&#xE99A;" />
                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="Bot 状态" />
                        <TextBlock x:Name="BotStateText" FontSize="24" FontWeight="SemiBold" Text="未运行" />
                        <TextBlock x:Name="BotIdentityText" Foreground="{StaticResource SecondaryTextBrush}" Text="尚未连接 Discord" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Padding="22" Background="{StaticResource CardBrush}" CornerRadius="6">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="6">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="快速控制" />
                        <TextBlock x:Name="RuntimeDetailText" Foreground="{StaticResource SecondaryTextBrush}" Text="等待运行状态…" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                        <Button Click="StartBot_Click" Content="▶  启动 Bot" Background="#236B45" />
                        <Button Click="StopBot_Click" Content="■  停止 Bot" />
                        <Button Click="Minimize_Click" Content="最小化到托盘" />
                        <Button Click="Exit_Click" Content="退出管理器" Foreground="{StaticResource DangerBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <InfoBar x:Name="MessageBar" IsOpen="False" IsClosable="True" />
        </StackPanel>
    </ScrollViewer>
</Page>
