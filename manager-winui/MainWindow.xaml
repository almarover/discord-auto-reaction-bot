<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="DiscordReactionManager_WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Discord Auto Reaction Bot 管理器">
    <Window.SystemBackdrop><MicaBackdrop Kind="BaseAlt" /></Window.SystemBackdrop>
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.Resources>
            <Style x:Key="NavSquareButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="68" />
                <Setter Property="Height" Value="68" />
                <Setter Property="Margin" Value="4" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="5" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="Discord Auto Reaction Bot 管理器" IsBackButtonVisible="False" IsPaneToggleButtonVisible="False" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="76" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Background="{StaticResource SidebarBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <Button x:Name="HomeNavButton" Style="{StaticResource NavSquareButtonStyle}" Tag="home" Click="NavButton_Click" ToolTipService.ToolTip="主页">
                        <Grid>
                            <Rectangle x:Name="HomeIndicator" Width="3" Height="20" HorizontalAlignment="Left" Fill="{StaticResource AccentGreenBrush}" RadiusX="2" RadiusY="2" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                                <FontIcon FontSize="20" Glyph="&#xE80F;" />
                                <TextBlock HorizontalAlignment="Center" FontSize="11" Text="主页" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button x:Name="PublicNavButton" Style="{StaticResource NavSquareButtonStyle}" Tag="public" Click="NavButton_Click" ToolTipService.ToolTip="公共">
                        <Grid>
                            <Rectangle x:Name="PublicIndicator" Width="3" Height="20" HorizontalAlignment="Left" Fill="{StaticResource AccentGreenBrush}" RadiusX="2" RadiusY="2" Visibility="Collapsed" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                                <FontIcon FontSize="20" Glyph="&#xE774;" />
                                <TextBlock HorizontalAlignment="Center" FontSize="11" Text="公共" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button x:Name="ConfigNavButton" Style="{StaticResource NavSquareButtonStyle}" Tag="config" Click="NavButton_Click" ToolTipService.ToolTip="配置">
                        <Grid>
                            <Rectangle x:Name="ConfigIndicator" Width="3" Height="20" HorizontalAlignment="Left" Fill="{StaticResource AccentGreenBrush}" RadiusX="2" RadiusY="2" Visibility="Collapsed" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                                <FontIcon FontSize="20" Glyph="&#xE70F;" />
                                <TextBlock HorizontalAlignment="Center" FontSize="11" Text="配置" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button x:Name="LogsNavButton" Style="{StaticResource NavSquareButtonStyle}" Tag="logs" Click="NavButton_Click" ToolTipService.ToolTip="日志">
                        <Grid>
                            <Rectangle x:Name="LogsIndicator" Width="3" Height="20" HorizontalAlignment="Left" Fill="{StaticResource AccentGreenBrush}" RadiusX="2" RadiusY="2" Visibility="Collapsed" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                                <FontIcon FontSize="20" Glyph="&#xE9D2;" />
                                <TextBlock HorizontalAlignment="Center" FontSize="11" Text="日志" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </StackPanel>

                <Button x:Name="SettingsNavButton" Grid.Row="1" Style="{StaticResource NavSquareButtonStyle}" Tag="settings" Click="NavButton_Click" ToolTipService.ToolTip="设置">
                    <Grid>
                        <Rectangle x:Name="SettingsIndicator" Width="3" Height="20" HorizontalAlignment="Left" Fill="{StaticResource AccentGreenBrush}" RadiusX="2" RadiusY="2" Visibility="Collapsed" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                            <FontIcon FontSize="20" Glyph="&#xE713;" />
                            <TextBlock HorizontalAlignment="Center" FontSize="11" Text="设置" />
                        </StackPanel>
                    </Grid>
                </Button>
            </Grid>

            <Frame x:Name="NavFrame" Grid.Column="1" />
        </Grid>
    </Grid>
</Window>
